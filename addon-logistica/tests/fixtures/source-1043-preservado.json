{
  "controller_strings": [
    "\"LGCManutencaoVinculoSP\"",
    "\"addon-logistica.FreteVendaVinculoPOC\"",
    "\"SELECT V.TFV_NUNOTA_FRETE CUSTO, V.TFV_NUNOTA_VENDA NOTA, V.TFV_VLR_RATEIO VALOR, \"",
    "\"V.TFV_PERCENTUAL PERCENTUAL, V.TFV_ATIVO ATIVO, V.TFV_ORIGEM ORIGEM, V.TFV_OBSERVACAO OBSERVACAO, \"",
    "\"F.NUNOTA CABECALHO, F.NUMNOTA NF_CUSTO, F.VLRNOTA TOTAL_CUSTO, F.CONTABILIZADO CONTABILIZADO, \"",
    "\"N.NUMNOTA NF, N.CODEMP EMPRESA, N.SERIENOTA SERIE, TO_CHAR(N.DTNEG,'DD/MM/YYYY') DATA, P.NOMEPARC CLIENTE \"",
    "\"FROM TFV_VINCULO_FRETE_VENDA V LEFT JOIN TGFCAB F ON F.NUNOTA=V.TFV_NUNOTA_FRETE \"",
    "\"LEFT JOIN TGFCAB N ON N.NUNOTA=V.TFV_NUNOTA_VENDA LEFT JOIN TGFPAR P ON P.CODPARC=N.CODPARC \"",
    "\"Sess\u00e3o n\u00e3o autenticada.\"",
    "\"SHA-256\"",
    "\"custo\"",
    "\"nota\"",
    "\"valor\"",
    "\"percentual\"",
    "\"ativo\"",
    "\"origem\"",
    "\"observacao\"",
    "\"cabecalho\"",
    "\"nf_custo\"",
    "\"total_custo\"",
    "\"contabilizado\"",
    "\"<null>\"",
    "\":\"",
    "\";\"",
    "\"%02x\"",
    "\"Informe a pesquisa.\"",
    "\"P\u00e1gina inv\u00e1lida.\"",
    "\"NF_NUMERO\"",
    "\"NF_NUNOTA\"",
    "\"CUSTO_NUNOTA\"",
    "\"Tipo de pesquisa inv\u00e1lido.\"",
    "\"NF_NUMERO\"",
    "\"SELECT N.NUNOTA NOTA,N.NUMNOTA NF,N.CODEMP EMPRESA,N.SERIENOTA SERIE,TO_CHAR(N.DTNEG,'DD/MM/YYYY') DATA,P.NOMEPARC CLIENTE FROM TGFCAB N LEFT JOIN TGFPAR P ON P.CODPARC=N.CODPARC WHERE N.TIPMOV='V' AND N.NUMNOTA=:NUMERO \"",
    "\" WHERE \"",
    "\"NF_NUNOTA\"",
    "\"V.TFV_NUNOTA_VENDA\"",
    "\"V.TFV_NUNOTA_FRETE\"",
    "\"=:NUMERO \"",
    "\" AND N.CODEMP=:EMPRESA \"",
    "\" ORDER BY N.CODEMP,N.NUNOTA \"",
    "\" ORDER BY V.TFV_NUNOTA_FRETE,V.TFV_NUNOTA_VENDA \"",
    "\" OFFSET :OFFSET ROWS FETCH NEXT 51 ROWS ONLY\"",
    "\"NUMERO\"",
    "\"OFFSET\"",
    "\"EMPRESA\"",
    "\"versao\"",
    "\"orfao\"",
    "\"cabecalho\"",
    "\"observacao\"",
    "\"contabilizado\"",
    "\"tipo\"",
    "\"documentos\"",
    "\"vinculos\"",
    "\"itens\"",
    "\"mais\"",
    "\"pagina\"",
    "\"podeInativar\"",
    "\"podeSanear\"",
    "\"Informe o v\u00ednculo.\"",
    "\" WHERE V.TFV_NUNOTA_FRETE=:CUSTO AND V.TFV_NUNOTA_VENDA=:NOTA FOR UPDATE OF V.TFV_ATIVO NOWAIT\"",
    "\"CUSTO\"",
    "\"NOTA\"",
    "\"V\u00ednculo ausente ou n\u00e3o un\u00edvoco.\"",
    "\"cabecalho\"",
    "\"SELECT CONTABILIZADO FROM TGFCAB WHERE NUNOTA=:CUSTO FOR UPDATE NOWAIT\"",
    "\"CUSTO\"",
    "\"contabilizado\"",
    "\"contabilizado\"",
    "\"Documento alterado. Consulte novamente.\"",
    "\"SELECT COUNT(*) BLOQUEIOS FROM TGFFIN WHERE NUNOTA=:CUSTO AND (DTBAIXA IS NOT NULL OR NVL(VLRBAIXA,0)<>0 OR CTABCOBAIXA IS NOT NULL)\"",
    "\"CUSTO\"",
    "\"bloqueios\"",
    "\"H\u00e1 financeiro baixado relacionado ao custo. Opera\u00e7\u00e3o bloqueada.\"",
    "\"ativo\"",
    "\"contabilizado\"",
    "\"INSERT INTO LGC_HIST_VINCULO (ID,CUSTO,NOTA,VALOR,PERCENTUAL,ATIVO_ANTES,ATIVO_DEPOIS,CODUSU,DHALTER,MOTIVO,ORFAO,VERSAO) VALUES (:ID,:CUSTO,:NOTA,:VALOR,:PERCENTUAL,'S','N',:USUARIO,SYSTIMESTAMP,:MOTIVO,:ORFAO,:VERSAO)\"",
    "\"ID\"",
    "\"CUSTO\"",
    "\"NOTA\"",
    "\"VALOR\"",
    "\"valor\"",
    "\"PERCENTUAL\"",
    "\"percentual\"",
    "\"USUARIO\"",
    "\"MOTIVO\"",
    "\"ORFAO\"",
    "\"S\"",
    "\"N\"",
    "\"VERSAO\"",
    "\"UPDATE TFV_VINCULO_FRETE_VENDA SET TFV_ATIVO='N' WHERE TFV_NUNOTA_FRETE=:CUSTO AND TFV_NUNOTA_VENDA=:NOTA AND TFV_ATIVO='S'\"",
    "\"CUSTO\"",
    "\"NOTA\"",
    "\"V\u00ednculo alterado durante a opera\u00e7\u00e3o.\"",
    "\"sucesso\"",
    "\"mensagem\"",
    "\"V\u00ednculo inativado. Valores preservados, sem redistribui\u00e7\u00e3o para outras notas.\"",
